# Preserve the installed application and OS while replacing the bundled Node runtime.
# BASE_IMAGE must be an operator-owned, proven application image ID/digest.
# NODE_IMAGE is the official Node image pinned to its immutable digest.
ARG NODE_IMAGE=node:24.22.1-bookworm-slim@sha256:55fb5f5a527ea2c5c4a95f963e48ef90aa38c7b346054fdc8ee9957a2b55d205
ARG BASE_IMAGE
FROM ${NODE_IMAGE} AS security-runtime
FROM ${BASE_IMAGE}
ARG NODE_RUNTIME_RECIPE_REVISION
ARG NODE_IMAGE
COPY --from=security-runtime /usr/local/bin/node /usr/local/bin/node
LABEL deploy-os.node-runtime.recipe-revision=$NODE_RUNTIME_RECIPE_REVISION \
      deploy-os.node-runtime.source=$NODE_IMAGE \
      deploy-os.node-runtime.version="24.22.1"
